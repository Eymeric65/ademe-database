# The SQLite build is data, never source. Built by `python -m ademe.ingest`.
# No trailing slash: a symlinked database/ must be ignored too.
database
*.sqlite
*.sqlite-wal
*.sqlite-shm

node_modules
dist
.wrangler
test-results
playwright-report

# Staged from node_modules by scripts/stage-duckdb.mjs: 77 MB of engine that
# does not belong in git. See ADR-0009.
test/e2e/fixtures/vendor

# The departement aggregate: built by the weekly job from the published tree,
# fetched from R2 by every build. `src/seo/aggregates.sample.json` is the
# committed fixture a build with no credentials falls back to. See ADR-0046.
src/seo/aggregates.json

__pycache__
.pytest_cache
.venv
.claude

# ADEME_API_KEY lives here, never in the repo. See ADR-0013.
.env

# Private product notes: strategy, pricing, roadmap. Never published.
resources
